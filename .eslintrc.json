{
  "root": true,
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint", "react", "react-hooks", "react-refresh", "security", "prettier"],
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "security/detect-object-with-no-contours": "warn",
    "security/detect-buffer-noassert": "warn",
    "security/detect-child-process": "warn",
    "security/detect-disable-mustache": "off",
    "security/detect-non-iterable-concat": "off",
    "security/detect-non-iterable-regex": "off",
    "security/detect-new-buffer": "warn",
    "security/detect-pseudoRandomBytes": "warn",
    "security/detect-unsafe-regex-value": "warn",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "prettier/prettier": "error"
  },
  "settings": {
    "react": {
      "version": "18.3"
    }
  },
  "ignorePatterns": ["dist", "node_modules", "server/dist", "*.config.js", "*.config.ts", "*.config.cjs"]
}
